# ─── Sanity CMS ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2022-11-01
# Optional — only needed for authenticated/preview reads
SANITY_API_TOKEN=
# Shared secret for the Sanity webhook that hits /api/revalidate.
# Must match the Authorization: Bearer <value> header configured on the
# webhook in Sanity Studio (Manage → API → Webhooks).
SANITY_WEBHOOK_SECRET=

# ─── Resend (estimate + contact form email) ────────────────────────────────────
RESEND_API_KEY=
# Where form submissions are delivered
RESEND_TO_EMAIL=
# Must be on a domain verified in Resend. onboarding@resend.dev works for
# local/dev testing only (delivers to the Resend account owner's email).
RESEND_FROM_EMAIL=onboarding@resend.dev

# ─── Google Analytics ───────────────────────────────────────────────────────────
# Optional — leave blank to disable GA4. Set to a G-XXXXXXX measurement ID to enable.
NEXT_PUBLIC_GA_ID=

# ─── Google Ads conversion tracking (landing pages only, see docs/GOOGLE-TAG.md) ──
# AW-XXXXXXXXX id from the gtag.js snippet. Loaded only on /lp/* routes.
NEXT_PUBLIC_GOOGLE_TAG_ID=AW-XXXXXXXXX
# The conversion label from the "send_to" value of a specific conversion action
# in Google Ads (Goals → Summary → conversion action → "Tag setup" → the part
# after the slash, e.g. "AbC-D_efG-h123"). Leave blank until the client provides
# one — trackConversion() falls back to firing on the bare tag id.
NEXT_PUBLIC_GOOGLE_CONVERSION_LABEL=
